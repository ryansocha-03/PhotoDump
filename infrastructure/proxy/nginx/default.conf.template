server {
    listen ${PROXY_PORT};
    server_name ${APP_API_DOMAIN};
    location / {
        proxy_pass http://app-api:${APP_API_PORT};
    }
}

server {
    listen ${PROXY_PORT};
    server_name ${CONTENT_STORE_DOMAIN};

    location / {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin ${CORS_ALLOWED_ORIGIN} always;
            add_header Access-Control-Allow-Methods "PUT, GET, HEAD, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type, Content-Length, Origin, Accept" always;
            add_header Access-Control-Max-Age 86400 always;
            add_header Vary Origin always;
            return 204;
        }

        add_header Access-Control-Allow-Origin ${CORS_ALLOWED_ORIGIN} always;
        add_header Access-Control-Allow-Methods "PUT, GET, HEAD, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Content-Length, Origin, Accept" always;
        add_header Vary Origin always;

        client_max_body_size 5m;
        proxy_pass http://garage:${GARAGE_API_PORT};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $host;
    }
}